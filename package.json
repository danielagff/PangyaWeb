{
  "name": "pangyaweb",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pangya/client dev",
    "build": "pnpm --filter @pangya/client build",
    "server": "pnpm --filter @pangya/server dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "assets:build": "pnpm --filter @pangya/asset-pipeline cli build",
    "assets:exemplo": "pnpm --filter @pangya/asset-pipeline cli exemplo",
    "assets:index": "pnpm --filter @pangya/asset-pipeline cli index",
    "assets:iff": "pnpm --filter @pangya/asset-pipeline cli iff",
    "assets:pak": "pnpm --filter @pangya/asset-pipeline cli pak",
    "assets:pak-dump": "pnpm --filter @pangya/asset-pipeline cli pak-dump",
    "assets:pak-key": "pnpm --filter @pangya/asset-pipeline cli pak-key"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
